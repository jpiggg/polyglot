{
  "name": "boilerplate-react-typescript-nodejs",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:client": "rsbuild build --config=config/rsbuild/client.js",
    "build:server": "rsbuild build --config=config/rsbuild/server.js",
    "dev": "concurrently -k \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:client": "NODE_ENV=development rsbuild dev --config=config/rsbuild/client.js",
    "dev:server": "NODE_ENV=development pnpm run build:server && node ./dist/server/index.js",
    "docker:build": "docker build . -t boilerplate-react-typescript-nodejs",
    "docker:run": "docker run --name boilerplate-react-typescript-nodejs --rm -p 8080:8080 -it boilerplate-react-typescript-nodejs",
    "start": "node ./dist/server/index.js",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,scss,json}\"",
    "lint": "node ./scripts/lint/default.js && node ./scripts/lint/prettify.js",
    "lint:deep": "node ./scripts/lint/deep.js && node ./scripts/lint/prettify.js",
    "test": "jest",
    "prepare": "node ./scripts/hooks/install.js"
  },
  "keywords": [],
  "license": "MIT",
  "private": true,
  "author": "jpiggg <isdolinskayaym@gmail.com>",
  "sideEffects": false,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.2.5",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.30.6",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "uuid4": "^2.0.3",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.2",
    "@rsbuild/core": "^2.2.7",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@swc/core": "^1.3.95",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.4",
    "@types/node": "^24.13.5",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/react-redux": "^7.1.34",
    "@types/uuid4": "^2.0.2",
    "@types/xxhashjs": "^0.2.3",
    "@typescript-eslint/parser": "^6.9.1",
    "concurrently": "^10.0.5",
    "eslint": "^8.52.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "postcss-preset-env": "^9.3.0",
    "prettier": "^3.0.3",
    "prettify": "^0.1.0",
    "rimraf": "^5.0.5",
    "sass": "^1.69.5",
    "typescript": "^5.2.2",
    "webpack-node-externals": "^3.0.0"
  }
}
